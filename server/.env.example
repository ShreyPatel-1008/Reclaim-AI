# ============ Postgres (REQUIRED) ============
# You already have PostgreSQL 18 running on port 5432. Fill in the password you
# set for the 'postgres' user at install time. The app DB is created for you.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=revenue_recovery
# ...or provide a single connection string instead of the PG* vars above:
# DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/revenue_recovery

# ============ OpenRouter (optional — Diagnoser LLM for blank rows) ============
# Without a key, the 8 blank-code rows default to "unknown -> escalate".
OPENROUTER_API_KEY=
# Any OpenRouter model id. Free-tier examples:
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemini-2.0-flash-exp:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============ Razorpay (optional — real test-mode payment links) ============
# Without keys, send_payment_link uses a mock link. Get TEST keys from the
# Razorpay Dashboard → Settings → API Keys (test mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

PORT=4000
